<!doctype html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
		<title>Chia tiền chuyến đi</title>
		<meta
			name="description"
			content="Ghi chi tiêu chuyến đi, chia đều cho cả nhóm và gửi mã QR chuyển khoản có sẵn số tiền cho từng người."
		/>
		<meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)" />
		<link
			rel="icon"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230f766e'/%3E%3Cpath d='M9 16h14' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='10' r='2.5' fill='white'/%3E%3Ccircle cx='16' cy='22' r='2.5' fill='white'/%3E%3C/svg%3E"
		/>
	</head>
	<body>
		<main id="app"><noscript>Trang này cần bật JavaScript.</noscript></main>
		<script>
			import "@/apps/chia/app";
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #f4f1ea;
		--surface: #ffffff;
		--surface-2: #ebe7dd;
		--ink: #1c1a16;
		--muted: #6f6a60;
		--line: #e3ded2;
		--accent: #0f766e;
		--accent-ink: #ffffff;
		--accent-soft: #d6eeea;
		--warn: #b45309;
		--danger: #b91c1c;
		font-family:
			system-ui,
			-apple-system,
			"Segoe UI",
			Roboto,
			"Helvetica Neue",
			Arial,
			sans-serif;
		font-size: 16px;
		line-height: 1.45;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			color-scheme: dark;
			--bg: #14130f;
			--surface: #1f1d18;
			--surface-2: #2c2a23;
			--ink: #f3efe6;
			--muted: #a39d90;
			--line: #36332b;
			--accent: #2bb3a3;
			--accent-ink: #062b27;
			--accent-soft: #143c37;
			--warn: #f59e0b;
			--danger: #f87171;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		-webkit-tap-highlight-color: transparent;
	}
	main {
		max-width: 560px;
		margin: 0 auto;
		padding: 0 16px 24px;
	}
	body[data-view="trip"] main {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
		padding-bottom: 0;
	}
	h1 {
		font-size: 32px;
		line-height: 1.15;
		margin: 0 0 6px;
	}
	h2 {
		font-size: 18px;
		margin: 24px 0 10px;
	}
	p {
		margin: 0;
	}
	a {
		color: var(--accent);
	}
	.muted {
		color: var(--muted);
	}
	.small,
	.hint {
		font-size: 14px;
	}
	.hint {
		color: var(--muted);
	}
	.note {
		color: var(--muted);
		font-size: 14px;
		margin-top: 16px;
	}
	.warn {
		color: var(--warn);
	}
	.danger {
		color: var(--danger);
	}
	.error {
		color: var(--danger);
		font-size: 14px;
	}
	.error:empty {
		display: none;
	}

	/* Controls */
	button,
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 44px;
		padding: 0 16px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
		font-weight: 600;
	}
	.block {
		display: flex;
		width: 100%;
	}
	button.small,
	.button.small {
		min-height: 36px;
		padding: 0 12px;
		font-size: 15px;
	}
	.icon {
		min-width: 44px;
		padding: 0;
		border: none;
		background: transparent;
		font-size: 26px;
		line-height: 1;
		color: var(--ink);
	}
	.icon.danger {
		color: var(--danger);
	}
	.link {
		min-height: 32px;
		padding: 0 4px;
		border: none;
		background: none;
		color: var(--accent);
		font-weight: 600;
	}
	.link.danger {
		color: var(--danger);
	}
	input,
	select {
		width: 100%;
		min-height: 48px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 16px;
	}
	input[type="checkbox"] {
		width: 22px;
		min-height: 22px;
		height: 22px;
		accent-color: var(--accent);
	}
	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.stack {
		display: grid;
		gap: 16px;
	}
	.field {
		display: grid;
		gap: 6px;
	}
	.field label {
		font-weight: 600;
		font-size: 15px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
	}
	.chips:empty {
		display: none;
	}
	.chip {
		min-height: 36px;
		max-width: 100%;
		padding: 0 14px;
		border: 1px solid transparent;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--ink);
		font-size: 15px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	span.chip {
		display: inline-flex;
		align-items: center;
		padding-right: 4px;
	}
	.chip.on {
		background: var(--accent-soft);
		border-color: var(--accent);
		color: var(--accent);
		font-weight: 600;
	}
	.chip-x {
		min-height: 28px;
		min-width: 28px;
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		font-size: 18px;
	}
	.chip-input {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 6px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--surface);
	}
	.chip-input input {
		flex: 1;
		min-width: 150px;
		min-height: 36px;
		padding: 0 8px;
		border: none;
	}
	.chip-input input:focus-visible {
		outline: none;
	}
	.card {
		display: block;
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: var(--surface);
	}

	/* Layout pieces */
	.intro {
		padding: 32px 0 20px;
	}
	.bar {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 6px;
		margin: 0 -16px;
		padding: 8px 12px;
		padding-top: max(8px, env(safe-area-inset-top));
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.bar-title {
		flex: 1;
		min-width: 0;
		display: grid;
	}
	.bar-title > * {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	ul,
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.trips {
		display: grid;
		gap: 10px;
		margin-top: 16px;
	}
	.trip {
		display: grid;
		gap: 4px;
		color: var(--ink);
		text-decoration: none;
	}
	.pill {
		justify-self: start;
		margin-top: 4px;
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--muted);
		font-size: 13px;
	}
	.pill.ok {
		background: var(--accent-soft);
		color: var(--accent);
	}

	/* Expenses */
	.grow {
		flex: 1;
		padding: 12px 0;
	}
	.empty {
		display: grid;
		gap: 6px;
		padding: 40px 8px;
		text-align: center;
	}
	.expenses {
		display: grid;
		gap: 8px;
	}
	.expense {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		width: 100%;
		min-height: 60px;
		padding: 10px 14px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--surface);
		text-align: left;
	}
	.expense.editing {
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}
	.expense-main {
		display: grid;
		min-width: 0;
	}
	.expense-main > * {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.amount {
		white-space: nowrap;
	}
	.composer {
		position: sticky;
		bottom: 0;
		z-index: 2;
		display: grid;
		gap: 8px;
		margin: 0 -16px;
		padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
		background: var(--bg);
		border-top: 1px solid var(--line);
	}
	.composer-head {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.composer-head strong {
		flex: 1;
	}
	.composer-row {
		display: flex;
		gap: 8px;
		align-items: center;
	}
	.composer-row input[name="name"] {
		flex: 1.4;
		min-width: 0;
	}
	.composer-row input[name="amount"] {
		flex: 1;
		min-width: 0;
	}
	.composer-row .chip {
		flex: 0 1 auto;
		min-width: 0;
	}
	.push {
		margin-left: auto;
		flex: none;
	}
	.preview {
		font-size: 14px;
		color: var(--muted);
		padding: 0 4px;
	}
	.panel {
		display: grid;
		gap: 8px;
		padding: 10px 12px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--surface);
	}

	/* Summary */
	.setup {
		display: grid;
		gap: 12px;
		margin-top: 16px;
	}
	.setup h2 {
		margin: 0;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 8px;
		margin-top: 16px;
	}
	.stat {
		display: grid;
		gap: 2px;
	}
	.stat strong {
		font-size: 20px;
	}
	.progress-box {
		display: grid;
		gap: 6px;
		margin-top: 14px;
	}
	.progress {
		height: 8px;
		border-radius: 999px;
		background: var(--surface-2);
		overflow: hidden;
	}
	.progress span {
		display: block;
		height: 100%;
		background: var(--accent);
	}
	.people {
		display: grid;
		gap: 10px;
	}
	.person {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 4px 12px;
		align-items: center;
	}
	.person-main {
		display: grid;
		min-width: 0;
	}
	.due {
		font-size: 18px;
		white-space: nowrap;
	}
	.person-actions {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 6px;
	}
	.person.done .person-main > :not(.pill),
	.person.done .due {
		opacity: 0.55;
	}
	.check {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-size: 15px;
	}
	.total-row {
		display: flex;
		justify-content: space-between;
		padding: 12px 4px;
		margin-bottom: 12px;
		font-size: 17px;
	}
	.members {
		display: grid;
		gap: 8px;
	}
	.members li {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.accent {
		color: var(--accent);
	}
	.loading {
		padding: 64px 0;
		text-align: center;
		color: var(--muted);
	}
	.person-buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}
	.person-buttons {
		justify-content: flex-end;
		margin-left: auto;
	}
	.person-main .pill {
		justify-self: start;
		margin-top: 6px;
	}
	.link-input {
		font-size: 15px;
		color: var(--muted);
	}
	.grow-1 {
		flex: 1;
	}

	/* One person's transfer screen */
	.hero {
		display: grid;
		justify-items: center;
		gap: 8px;
		margin-top: 16px;
		text-align: center;
	}
	.hero-amount {
		font-size: 40px;
		font-weight: 800;
		line-height: 1.1;
		color: var(--accent);
	}
	.hero-amount.warn {
		color: var(--warn);
	}
	.qr-block {
		display: grid;
		justify-items: center;
		gap: 10px;
		width: 100%;
		margin-top: 8px;
	}
	.qr {
		width: min(260px, 100%);
		height: auto;
		aspect-ratio: 1;
		border-radius: 12px;
		background: #ffffff;
		image-rendering: pixelated;
	}
	.info {
		display: grid;
		gap: 2px;
		margin-top: 12px;
		padding-top: 6px;
		padding-bottom: 6px;
	}
	.info-row {
		display: grid;
		grid-template-columns: 96px 1fr auto;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		border-bottom: 1px solid var(--line);
	}
	.info-row:last-child {
		border-bottom: none;
	}
	.info-row strong {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	/* Dialogs */
	.sheet {
		width: min(560px, 100%);
		max-width: 100%;
		max-height: 92dvh;
		margin: auto auto 0;
		padding: 0;
		border: none;
		border-radius: 20px 20px 0 0;
		background: var(--surface);
		color: var(--ink);
	}
	.sheet::backdrop {
		background: rgb(0 0 0 / 0.45);
	}
	@media (min-width: 600px) {
		.sheet {
			margin: auto;
			border-radius: 20px;
		}
	}
	.sheet-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 8px 0 16px;
	}
	.sheet-body {
		display: grid;
		gap: 10px;
		padding: 8px 16px calc(16px + env(safe-area-inset-bottom));
	}
	.bill {
		width: 100%;
		max-height: 55dvh;
		object-fit: contain;
		object-position: top;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #f4f1ea;
	}
	.toast {
		position: fixed;
		left: 50%;
		bottom: calc(150px + env(safe-area-inset-bottom));
		z-index: 10;
		max-width: calc(100% - 32px);
		padding: 10px 16px;
		border-radius: 12px;
		background: var(--ink);
		color: var(--bg);
		font-size: 15px;
		opacity: 0;
		transform: translateX(-50%);
		transition: opacity 0.2s;
		pointer-events: none;
	}
	.toast.show {
		opacity: 1;
	}
</style>
